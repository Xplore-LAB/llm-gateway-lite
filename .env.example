# ====== 大模型统一接入网关 (LLM Gateway) 配置文件 ======

# ----------------------------------------------------
# 推荐做法：如果你只用一家公司，设置以下两个变量即可全局生效
# ----------------------------------------------------
OPENAI_API_KEY="sk-xxxxxxxxxxxxxxxxxxxxxxxx"
# 如果使用非 OpenAI 官方模型，修改下面的 Base URL 即可
# OPENAI_BASE_URL="https://api.deepseek.com"

# 使用的模型名称
MODEL_NAME="gpt-4o"

# ----------------------------------------------------
# 进阶做法：如果你想同时用多家公司的模型，可以分别配置专属 KEY
# (网关底层会自动读取对应的环境变量)
# ----------------------------------------------------
# 1. Anthropic (Claude)
ANTHROPIC_API_KEY="sk-ant-xxx"
# ANTHROPIC_BASE_URL="https://api.anthropic.com/v1"

# 2. Local Qwen (本地/内网穿透)
# LOCAL_QWEN_API_KEY="your-key"
# LOCAL_QWEN_BASE_URL="http://localhost:8000/v1"

# 3. 其他常见厂商
# DEEPSEEK_API_KEY="sk-deepseek-xxx"
# QWEN_API_KEY="sk-qwen-xxx"
# ZHIPU_API_KEY="sk-zhipu-xxx"
# MOONSHOT_API_KEY="sk-kimi-xxx"
# SILICONFLOW_API_KEY="sk-siliconflow-xxx"
